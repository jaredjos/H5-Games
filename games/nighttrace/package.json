{
  "name": "nighttrace",
  "private": true,
  "version": "1.24.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-cinematic-audio.mjs && tsc -b && vite build && node scripts/verify-subpath-build.mjs",
    "build:internal": "node scripts/verify-cinematic-audio.mjs && tsc -b && vite build --mode internal --outDir dist-internal && node scripts/verify-subpath-build.mjs dist-internal",
    "audio:render": "node scripts/render-original-music.mjs",
    "voice:campaign": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-cinematic-voices.ps1",
    "voice:campaign:dry-run": "node scripts/render-cinematic-voices.mjs --dry-run",
    "voice:campaign:batch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-cinematic-voices-batch.ps1",
    "voice:campaign:batch:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-cinematic-voices-batch.ps1 -Mode Status",
    "voice:campaign:batch:resume": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-cinematic-voices-batch.ps1 -Mode Resume",
    "voice:campaign:batch:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-cinematic-voices-batch.ps1 -Mode Watch",
    "voice:campaign:review:auto": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-cinematic-voices-batch.ps1 -Mode Review",
    "voice:campaign:review:dry-run": "node scripts/render-cinematic-voices-batch.mjs --mode review-auto --dry-run",
    "voice:campaign:promote-approved": "node scripts/promote-approved-cinematic-voices.mjs",
    "voice:campaign:batch:dry-run": "node scripts/render-cinematic-voices-batch.mjs --dry-run",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:audio": "node scripts/verify-cinematic-audio.mjs",
    "verify:build": "node scripts/verify-subpath-build.mjs",
    "preview": "vite preview",
    "preview:internal": "vite preview --outDir dist-internal"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
